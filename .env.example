# Gitea Configuration
GITEA_INSTANCE_URL=https://gitea.yourdomain.com
GITEA_TOKEN=your_gitea_personal_access_token_here

# Open-WebUI Configuration
OWUI_INSTANCE_URL=http://localhost:8080
# Static fallback token (admin/API key). Used when no forwarded user token
# is present: /context/health always, and the chat-data endpoints only in
# legacy mode (OWUI_ALLOW_USER_TOKEN=false).
OWUI_TOKEN=your_openwebui_api_key_here

# Per-User Identity Configuration
# Accept per-user tokens forwarded from Open-WebUI (default: true).
# Chat-data endpoints then REQUIRE a forwarded user token and never use
# the static OWUI_TOKEN. Set to false to run everything as OWUI_TOKEN.
OWUI_ALLOW_USER_TOKEN=true
# When set, forwarded-token requests must also carry a valid signed
# X-OpenWebUI-User-Jwt header (tamper detection; a missing/invalid header
# is a 401). Must equal Open-WebUI's JWT_SECRET.
OWUI_FORWARD_JWT_SECRET=
# Seconds to cache validated user tokens (default: 300).
OWUI_TOKEN_CACHE_TTL=300

# Company Vetting Configuration
# The one optional search-engine query (exact company name) for the
# third-party-mention check. Everything else is a direct lookup
# (RDAP, the website itself, the Wayback Machine).
VET_ENABLE_MENTIONS=true
# Max results for the mention check (default: 10).
VET_MENTION_MAX_RESULTS=10
# Seconds to reuse an identical verdict (same name + domain, default: 86400).
VET_CACHE_TTL=86400
# Optional direct registry lookup URL; {query} is replaced with the
# URL-encoded company name. Leave empty to derive the registry check
# from the Impressum (handelsregister.de is not plain-GET queryable).
VET_REGISTRY_URL_TEMPLATE=

# Server Configuration
HOST=0.0.0.0
PORT=8090
LOG_LEVEL=info
